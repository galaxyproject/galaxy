<object_store type="cloud" provider="azure">
     <auth subscription_id="a_sub_id" client_id="and_a_client_id" secret="and_a_secret_key" tenant="and_some_tenant_info" storage_account="galaxystorage" resource_group="galaxy_rg" region="eastus2" />
     <bucket name="unique_container_name" use_reduced_redundancy="False" />
     <cache path="database/object_store_cache" size="1000" />
