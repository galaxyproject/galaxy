<!-- In order to use this converter the admin has to install its dependency pyarrow e.g. through the Galaxy admin UI -->
<tool id="CONVERTER_parquet_to_tabular" name="Convert Parquet to tabular" version="1.0.0" profile="19.05">
    <requirements>
        <requirement type="package" version="24.0.0">pyarrow</requirement>
    </requirements>
    <command>python '$__tool_directory__/parquet_to_tabular_converter.py' '$input' '$output'</command>
    <inputs>
        <param name="input" type="data" format="parquet" label="Parquet file"/>
    </inputs>
    <outputs>
        <data name="output" format="tabular">
            <actions>
                <action name="column_names" type="metadata" default="$input.metadata.column_names.replace('__ob__', '').replace('__sq__', '').replace('__cb__', '')"/>
            </actions>
        </data>
    </outputs>
    <tests>
        <test>
            <param name="input" ftype="parquet" value="parq_conv.parquet"/>
            <output name="output" ftype="tabular" value="parq_conv.tabular"/>
        </test>
    </tests>
    <help>
    </help>
</tool>
