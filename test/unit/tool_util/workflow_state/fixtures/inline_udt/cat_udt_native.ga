{
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "name": "inline udt cat",
  "steps": {
    "0": {
      "id": 0,
      "type": "data_input",
      "label": "the_input",
      "tool_state": "{}",
      "input_connections": {},
      "inputs": [{"description": "", "name": "the_input"}],
      "outputs": []
    },
    "1": {
      "id": 1,
      "type": "tool",
      "label": "the_udt",
      "tool_id": null,
      "tool_version": null,
      "tool_representation": {
        "class": "GalaxyUserTool",
        "id": "cat_user_defined",
        "name": "cat_user_defined",
        "version": "0.1",
        "container": "busybox",
        "shell_command": "head -n '$(inputs.n_lines)' '$(inputs.input1.path)' > output.txt",
        "inputs": [
          {"name": "input1", "type": "data", "format": "txt"},
          {"name": "n_lines", "type": "integer", "value": 10}
        ],
        "outputs": [
          {"name": "output1", "type": "data", "format": "txt", "from_work_dir": "output.txt"}
        ]
      },
      "tool_state": {"input1": {"__class__": "ConnectedValue"}, "n_lines": 10},
      "input_connections": {"input1": {"id": 0, "output_name": "output"}},
      "outputs": [],
      "uuid": "00000000-0000-0000-0000-000000000001"
    }
  }
}
