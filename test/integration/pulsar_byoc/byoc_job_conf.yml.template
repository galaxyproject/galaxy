# Job configuration for the BYOC tool-execution integration test.
#
# This file is rendered by the test fixture with one placeholder:
#   {{tpv_config_file}}  — absolute path to the TPV YAML rendered for the test
#
# All jobs route to the ``dynamic_tpv`` dispatcher, which loads the TPV
# config and falls through to the ``pulsar_byoc`` destination once
# ``app.byoc_manager.get_active_for(user)`` returns the resource the test
# inserts in ``_configure_app``.

runners:
  pulsar_byoc:
    load: galaxy.jobs.runners.pulsar:PulsarMQBYOCJobRunner

execution:
  default: tpv_dispatcher
  environments:
    tpv_dispatcher:
      runner: dynamic_tpv
      tpv_config_files:
        - {tpv_config_file}
