# TPV config for the BYOC tool-execution integration test.
#
# Mirrors the operator-shipped lib/galaxy/config/sample/tpv/byoc.yml.sample
# stanza plus a minimal base so the mapper can resolve. ``default_inherits``
# = ``default`` so the catch-all tool rule fires for every tool, and the
# fallback ``default`` destination keeps non-BYOC users running.

global:
  default_inherits: default

destinations:
  default:
    runner: pulsar_byoc
    max_accepted_cores: 16
    max_accepted_mem: 64
    scheduling:
      accept: [general]
  pulsar_byoc:
    runner: pulsar_byoc
    params:
      jobs_directory: __JOBS_DIR__
    scheduling:
      require: [pulsar_byoc]
    rules:
      - id: inject_byoc_params
        if: app.byoc_manager.get_active_for(user) is not None
        params:
          pulsar_byoc_resource_id: "{app.byoc_manager.get_active_for(user).id}"
          relay_url: "{app.byoc_manager.get_active_for(user).relay_url}"
          manager: "{app.byoc_manager.get_active_for(user).manager_name}"

tools:
  default:
    cores: 1
    mem: 2
    scheduling:
      accept: [general]
    rules:
      - id: byoc_eligibility
        if: app.byoc_manager.get_active_for(user) is not None
        scheduling:
          require: [pulsar_byoc]
