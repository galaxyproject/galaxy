<tool id="zarr_store_in_wrapper_folder" name="zarr_store_in_wrapper_folder" version="0.1.0" profile="24.2">
    <!-- Writes a zarr store inside a single wrapper folder; metadata setting moves it to the root. -->
    <command><![CDATA[
mkdir -p '$output.extra_files_path/wrapped.zarr/0' &&
echo '{"zarr_format": 2}' > '$output.extra_files_path/wrapped.zarr/.zgroup' &&
echo '{"zarr_format": 2, "shape": [1], "chunks": [1], "dtype": "<i4", "compressor": null, "fill_value": 0, "filters": null, "order": "C"}' > '$output.extra_files_path/wrapped.zarr/0/.zarray'
    ]]></command>
    <inputs>
    </inputs>
    <outputs>
        <data name="output" format="zarr"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <output name="output" ftype="zarr">
                <metadata name="zarr_format" value="2"/>
                <extra_files type="file" name=".zgroup">
                    <assert_contents>
                        <has_text text="zarr_format"/>
                    </assert_contents>
                </extra_files>
                <extra_files type="file" name="0/.zarray">
                    <assert_contents>
                        <has_text text="zarr_format"/>
                    </assert_contents>
                </extra_files>
            </output>
        </test>
    </tests>
</tool>
