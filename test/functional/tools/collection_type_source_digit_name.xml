<tool id="collection_type_source_digit_name" name="collection_type_source_digit_name" version="0.1.0">
  <command>
    mkdir output;
    #for $key in $reads_1.keys()#
    cat "$reads_1[$key]" > output/"$key";
    #end for#
  </command>
  <inputs>
    <param name="reads_1" type="data_collection" collection_type="list" />
  </inputs>
  <outputs>
    <collection name="list_output" type_source="reads_1" format="txt">
      <discover_datasets pattern="__name__" directory="output" visible="true" />
    </collection>
  </outputs>
  <tests>
    <test>
      <param name="reads_1">
        <collection type="list">
          <element name="samp1" value="simple_line.txt" />
        </collection>
      </param>
      <output_collection name="list_output" type="list" count="1">
        <element name="samp1" file="simple_line.txt" />
      </output_collection>
    </test>
  </tests>
</tool>
