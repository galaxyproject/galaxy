<!-- Test tool for Crypt4GH support: outputs that are encrypted already are not encrypted again. -->
<tool id="crypt4gh_pass_through" name="crypt4gh_pass_through" version="1.0.0" profile="24.0">
    <description>copies a decrypted and an encrypted input to its outputs</description>
    <command><![CDATA[
cat '$input1' > '$decrypted' &&
cp '$input2' '$passed'
    ]]></command>
    <inputs>
        <param name="input1" type="data" format="txt" label="Decrypted dataset"/>
        <param name="input2" type="data" format="c4gh" label="Encrypted dataset"/>
    </inputs>
    <outputs>
        <data name="decrypted" format="txt"/>
        <data name="passed" format="c4gh"/>
    </outputs>
</tool>
