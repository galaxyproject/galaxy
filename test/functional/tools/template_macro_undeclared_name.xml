<tool id="template_macro_undeclared_name" name="template_macro_undeclared_name" version="1.0.0" profile="24.0">
    <macros>
        <template name="macro_text">text from the template macro</template>
    </macros>
    <command><![CDATA[
echo '$macro_text' > '$out_file1' &&
echo '$declared' >> '$out_file1'
#if $varExists("undeclared")
&& echo 'undeclared name in the template namespace' >> '$out_file1'
#end if
    ]]></command>
    <inputs>
        <param name="declared" type="text" value="declared value" />
    </inputs>
    <outputs>
        <data name="out_file1" format="txt" />
    </outputs>
    <tests>
        <test>
            <output name="out_file1">
                <assert_contents>
                    <has_line line="text from the template macro" />
                    <has_line line="declared value" />
                </assert_contents>
            </output>
        </test>
    </tests>
</tool>
