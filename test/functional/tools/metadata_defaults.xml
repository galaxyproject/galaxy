<tool id="metadata_defaults" name="metadata_defaults" version="0.1.0" profile="23.0">
    <command><![CDATA[
for i in 1 2 3 4 5 6 7; do echo '# comment'; done > '$summary' &&
printf 'run1\t2\t1\t0.9\tfeature1\n' >> '$summary' &&
for i in 1 2 3; do echo '# comment'; done > '$selection' &&
printf 'feature1\n' >> '$selection'
    ]]></command>
    <inputs />
    <outputs>
        <data name="summary" format="tabular">
            <actions>
                <action name="column_names" type="metadata" default="Run ID,Group Size,Retraining,Accuracy,Excluded Feature" />
                <action name="column_types" type="metadata" default="str,int,int,float,str" />
                <action name="comment_lines" type="metadata" default="7" />
            </actions>
        </data>
        <data name="selection" format="tabular">
            <actions>
                <action name="column_names" type="metadata" default="Feature" />
                <action name="column_types" type="metadata" default="str" />
                <action name="comment_lines" type="metadata" default="3" />
            </actions>
        </data>
    </outputs>
    <tests>
        <test>
            <output name="summary" ftype="tabular">
                <metadata name="comment_lines" value="7" />
                <metadata name="column_names" value="Run ID,Group Size,Retraining,Accuracy,Excluded Feature" />
                <metadata name="column_types" value="str,int,int,float,str" />
                <assert_contents><has_text text="run1" /></assert_contents>
            </output>
            <output name="selection" ftype="tabular">
                <metadata name="comment_lines" value="3" />
                <metadata name="column_names" value="Feature" />
                <metadata name="column_types" value="str" />
                <assert_contents><has_text text="feature1" /></assert_contents>
            </output>
        </test>
    </tests>
</tool>
