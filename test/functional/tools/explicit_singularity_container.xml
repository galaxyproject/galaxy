<tool id="explicit_singularity_container" name="explicit_singularity_container" version="0.1.0">
    <requirements>
        <container type="singularity">oras://ghcr.io/apptainer/alpine:3.15.0</container>
    </requirements>
    <stdio>
        <exit_code range="2:" />
    </stdio>
    <command><![CDATA[
cat /etc/alpine-release > '$output_1' 2>&1 &&

touch "\${TMP:-/tmp}/job_tmp" &&
touch "\${TEMP:-/tmp}/job_temp" &&
touch "\${TMPDIR:-/tmp}/job_tmpdir"
    ]]></command>
    <inputs>
    </inputs>
    <outputs>
        <data name="output_1" />
    </outputs>
    <tests>
    </tests>
    <help><![CDATA[
        TODO: Fill in help.
    ]]></help>
</tool>
