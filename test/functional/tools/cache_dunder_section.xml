<tool id="cache_dunder_section" name="Cache dunder section" version="1.0">
    <command><![CDATA[
echo '$__q2galaxy__GUI__section__extra_opts__.value' > '$output'
#if $__q2galaxy__GUI__section__extra_opts__.input1
&& cat '$__q2galaxy__GUI__section__extra_opts__.input1' >> '$output'
#end if
    ]]></command>
    <inputs>
        <section name="__q2galaxy__GUI__section__extra_opts__" title="Options">
            <param name="value" type="integer" value="1" />
            <param name="input1" type="data" format="txt" optional="true" />
        </section>
    </inputs>
    <outputs>
        <data name="output" format="txt" />
    </outputs>
</tool>
